# =======================================================
# MITRA – SMART MARKET PRICE ASSISTANT ENVIRONMENT CONFIG
# =======================================================

# Official Government Mandi Price API (Agmarknet / data.gov.in)
# Register and generate free API key at: https://data.gov.in/
# If left empty, Mitra runs in transparent "SAMPLE DATA — NOT LIVE" mode
VITE_AGMARKNET_API_KEY=

# Government Open Data Portal API Key
VITE_DATA_GOV_API_KEY=

# Live SMS Gateway Provider Configuration (Optional)
# Supported: Fast2SMS, Twilio, Gupshup
# When empty, Mitra operates with the interactive Farmer SMS Simulator
VITE_SMS_PROVIDER_NAME=Fast2SMS
VITE_SMS_PROVIDER_API_KEY=

# Optional Supabase Database Configuration (for storing farmer favorite mandis / price alerts)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
